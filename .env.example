# ---------------------------------------------------------------------------
# Firebase — SDK do cliente (públicas, ficam expostas no navegador; isso é
# esperado e seguro — a segurança real vem das Firestore Rules + Admin SDK)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK — SOMENTE no servidor. NUNCA prefixe com NEXT_PUBLIC_
# e nunca faça commit destes valores. Vêm do arquivo JSON de "service account"
# baixado no Firebase Console (ver docs/SETUP-PASSO-A-PASSO.md).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave privada inteira, com as quebras de linha como \n (uma linha só)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
